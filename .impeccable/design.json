  "components": [
    {"name":"Primary Order Button","kind":"button","refersTo":"button-primary","description":"Main WhatsApp action.","html":"<button class=\"ds-order\">Pedir por WhatsApp</button>","css":".ds-order{min-height:52px;border:0;border-radius:999px;background:var(--mustard);padding:0 28px;color:var(--ink);font:900 15px Manrope,sans-serif;transition:160ms}.ds-order:hover{transform:translateY(-2px);background:var(--cream)}.ds-order:focus-visible{outline:3px solid var(--mustard);outline-offset:5px}.ds-order:active{transform:scale(.97)}"},
    {"name":"Category Tabs","kind":"chip","refersTo":"category-tab-selected","description":"Scrollable accessible category selector.","html":"<div class=\"ds-tabs\" role=\"tablist\"><button aria-selected=\"true\">Hamburguesas</button><button>Perros</button><button>Platos y picadas</button></div>","css":".ds-tabs{display:flex;gap:10px;overflow-x:auto}.ds-tabs button{flex:none;min-height:46px;border:2px solid var(--ink);border-radius:999px;background:transparent;padding:0 20px;font:800 14px Manrope,sans-serif}.ds-tabs button[aria-selected=true]{background:var(--ink);color:var(--cream)}.ds-tabs button:hover{background:var(--mustard)}.ds-tabs button:focus-visible{outline:3px solid var(--tomato);outline-offset:5px}"},
    {"name":"Menu Item","kind":"button","description":"Ruled add-to-cart row.","html":"<button class=\"ds-item\"><span>Doble o triple</span><b>＋ Agregar</b></button>","css":".ds-item{display:flex;width:100%;min-height:94px;align-items:center;justify-content:space-between;border:0;border-bottom:1px solid rgb(28 12 8/45%);background:transparent;padding:20px 24px;color:var(--ink);font:800 17px Manrope,sans-serif}.ds-item b{color:var(--tomato);font-size:13px;text-transform:uppercase}.ds-item:hover{background:oklch(.92 .075 84);transform:translateY(-2px)}.ds-item:focus-visible{outline:3px solid var(--tomato);outline-offset:5px}"},
    {"name":"Cart Control","kind":"button","refersTo":"cart-fab","description":"Persistent cart with quantity badge.","html":"<button class=\"ds-cart\">🛒<span>3</span></button>","css":".ds-cart{position:relative;width:62px;height:62px;border:0;border-radius:50%;background:var(--mustard);color:var(--ink);box-shadow:0 12px 30px rgb(28 12 8/25%)}.ds-cart span{position:absolute;top:-4px;right:-2px;display:grid;min-width:24px;height:24px;place-items:center;border:2px solid var(--cream);border-radius:999px;background:var(--tomato);color:var(--cream);font:900 12px Manrope,sans-serif}.ds-cart:focus-visible{outline:3px solid var(--tomato);outline-offset:5px}"},
    {"name":"Cart Item","kind":"custom","description":"Quantity editor inside the cream drawer.","html":"<div class=\"ds-cart-item\"><b>Hamburguesa doble</b><div><button>−</button><strong>2</strong><button>＋</button><button class=\"ds-remove\">×</button></div></div>","css":".ds-cart-item{display:grid;gap:18px;border-bottom:1px solid rgb(28 12 8/35%);background:var(--cream);padding:24px 0;color:var(--ink);font-family:Manrope,sans-serif}.ds-cart-item div{display:flex;align-items:center;gap:13px}.ds-cart-item button{width:36px;height:36px;border:1px solid var(--ink);border-radius:50%;background:transparent}.ds-cart-item .ds-remove{margin-left:auto;border:0;color:var(--tomato)}"},
    {"name":"Promotion Band","kind":"card","description":"Ink field for variable promotions.","html":"<section class=\"ds-promo\"><span>Siempre hay algo bueno</span><h2>PREGUNTA POR LAS PROMOCIONES.</h2></section>","css":".ds-promo{background:var(--ink);padding:64px;color:var(--cream)}.ds-promo span{color:var(--mustard);font:900 13px Manrope,sans-serif;text-transform:uppercase}.ds-promo h2{max-width:10ch;margin:22px 0 0;font:400 clamp(48px,6vw,88px)/.88 'Archivo Black',sans-serif;letter-spacing:-.04em}"},
    {"name":"Add Confirmation Toast","kind":"custom","description":"Polite live-region feedback shown above the cart after adding an item.","html":"<div class=\"ds-toast\" role=\"status\"><span>✓</span>Listo: Hamburguesa doble</div>","css":".ds-toast{display:flex;align-items:center;gap:10px;border:2px solid var(--ink);background:var(--cream);padding:13px 16px;color:var(--ink);font:850 13px Manrope,sans-serif}.ds-toast span{display:grid;width:22px;height:22px;place-items:center;border-radius:50%;background:var(--tomato);color:var(--cream)}"},
    {"name":"Google Maps Location","kind":"card","description":"Two-column visit prompt and embedded map at the end of the mustard contact section.","html":"<section class=\"ds-map\"><div><span>Visítanos</span><h3>ENCUENTRA<br>DONDE KIKE.</h3><a href=\"#\">Abrir ubicación en Google Maps ↗</a></div><div class=\"ds-map-frame\">Google Maps</div></section>","css":".ds-map{display:grid;grid-template-columns:.55fr 1.45fr;gap:44px;align-items:end;border-top:2px solid var(--ink);background:var(--mustard);padding:54px 0 0;color:var(--ink)}.ds-map span{font:900 13px Manrope,sans-serif;text-transform:uppercase}.ds-map h3{margin:14px 0 26px;font:400 clamp(36px,4vw,58px)/.9 'Archivo Black',sans-serif;letter-spacing:-.04em}.ds-map a{font:900 14px Manrope,sans-serif;text-decoration:underline;text-underline-offset:5px}.ds-map-frame{display:grid;height:420px;place-items:center;background:var(--cream);font:800 14px Manrope,sans-serif}@media(max-width:760px){.ds-map{grid-template-columns:1fr;gap:30px}.ds-map-frame{height:340px}}"}
