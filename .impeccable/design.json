  "narrative": {
    "northStar":"The Sign-Painted Order Counter",
    "overview":"Donde Kike translates a familiar neighborhood fast-food counter into broad tomato, mustard, cream, and ink fields. One burger dominates the opening view; Archivo Black declarations feel like storefront signage, while Manrope keeps the large menu, cart, and WhatsApp ordering flow practical.\n\nThe system moves from appetite to category choice, product selection, cart editing, promotions, and WhatsApp handoff without inventing prices or claims. Photography supplies the only texture; the interface remains flat, typographic, and tactile.",
    "keyCharacteristics":["Full-bleed brand-color sections and hard ink rules.","Oversized Archivo Black declarations with compressed leading.","Horizontal pill tabs for menu categories.","Ruled add-to-cart menu rows.","Persistent mustard cart button and cream side drawer.","WhatsApp as the final ordering action."],
    "rules":[{"name":"The Four-Pot Rule","body":"Tomato, mustard, cream, and ink own the brand; state tints never introduce a new hue family.","section":"colors"},{"name":"The Painted Declaration Rule","body":"Never use Archivo Black for paragraphs or dense operational text.","section":"typography"},{"name":"The Browse-Then-Build Rule","body":"Show one category panel at a time rather than the entire catalog.","section":"layout"}],
    "dos":["Do lead with the burger and a direct WhatsApp action.","Do preserve one active category panel and keyboard tab behavior.","Do keep the cart persistent, quantity-aware, and editable.","Do preserve modal focus, Escape, scroll-lock, and visible-focus behavior.","Do phrase prices and promotions as information confirmed through WhatsApp."],
    "donts":["Don't publish unverified prices, addresses, partners, or fixed promotions.","Don't expose every category at once or wrap mobile tabs.","Don't add generic product cards, gradients, glass, or decorative shadows.","Don't remove persistent cart access or the multi-item WhatsApp summary."]
  }
